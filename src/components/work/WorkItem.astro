---
/**
 * WorkItem — one entry in the work list (used by /work and the home teaser).
 * Carries the filter facets (company/track) as data attributes and renders the
 * entry's pulled index figure. Alternates the figure side by index so the list
 * has rhythm without the parent needing :nth-child logic.
 */
import MetricFigure from "../charts/MetricFigure.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}
const { entry, index } = Astro.props;
const idx = entry.data.indexMetric ?? 0;
const metric = entry.data.metrics[idx];
const flip = index % 2 === 1;
---

<li
  class:list={["witem", { "witem--flip": flip }]}
  data-company={entry.data.company}
  data-track={entry.data.track}
  data-reveal
>
  <a class="witem__link" href={`/work/${entry.id}`}>
    <span class="mono witem__index">{String(index + 1).padStart(2, "0")}</span>
    <div class="witem__text">
      <span class="label witem__meta">
        {entry.data.company && <span class="witem__co">{entry.data.company}</span>}
        {entry.data.theme}
      </span>
      <h3 class="witem__name">{entry.data.title}</h3>
      <p class="witem__summary">{entry.data.summary}</p>
      <span class="mono witem__more">
        Read the case <span class="witem__arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
  {
    metric && (
      <div class="witem__figure">
        <MetricFigure metric={metric} />
      </div>
    )
  }
</li>

<style>
  .witem {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    border: var(--hair) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
  }

  .witem__link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
    align-items: start;
  }
  .witem__index { font-size: var(--step--1); color: var(--faint); padding-top: 0.5em; }
  .witem__text { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .witem__meta { color: var(--muted); display: inline-flex; gap: var(--space-3); align-items: baseline; }
  .witem__co {
    color: var(--accent);
    border: var(--hair) solid var(--accent);
    border-radius: 100px;
    padding: 0.1em 0.6em;
    font-size: 0.92em;
  }
  .witem__name {
    font-size: var(--step-3);
    font-weight: 520;
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    transition: color var(--dur-1) var(--ease-out);
    max-width: 22ch;
  }
  .witem__link:hover .witem__name { color: var(--accent); }
  .witem__summary {
    font-size: var(--step-0);
    color: var(--ink-soft);
    line-height: var(--leading-body);
    max-width: 46ch;
  }
  .witem__more {
    font-size: var(--step--1);
    color: var(--accent);
    margin-top: var(--space-1);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .witem__arrow { transition: transform var(--dur-2) var(--ease-out); }
  .witem__link:hover .witem__arrow { transform: translateX(4px); }

  .witem__figure {
    border-top: var(--hair) solid var(--line);
    padding-top: var(--space-5);
    margin-top: auto;
  }
</style>
