---
import { site } from "../../data/site";
const year = 2026;
---

<footer class="footer">
  <hr class="rule" />
  <div class="wrap footer__inner">
    <div class="footer__col">
      <p class="footer__statement">
        Find the abuse, prove it, and don't break the legitimate customers
        doing it.
      </p>
    </div>
    <div class="footer__meta">
      <a class="mono footer__link" href={`mailto:${site.email}`}>{site.email}</a>
      <a
        class="mono footer__link"
        href={site.linkedin}
        rel="me noopener"
        target="_blank">{site.linkedinLabel}</a
      >
      <span class="label footer__rights">
        © {year} {site.name} · {site.location}
      </span>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: var(--space-10); }
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8) var(--space-7);
    align-items: end;
  }
  @media (min-width: 52rem) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-8);
    }
  }
  .footer__statement {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 480;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
    max-width: 30ch;
    color: var(--ink-soft);
  }
  .footer__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }
  @media (min-width: 52rem) {
    .footer__meta { align-items: flex-end; text-align: right; }
  }
  .footer__link {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 1px;
    transition: border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .footer__link:hover { color: var(--accent); border-color: var(--accent); }
  .footer__rights { color: var(--faint); margin-top: var(--space-2); }
</style>
