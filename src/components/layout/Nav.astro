---
import { site, nav } from "../../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__id" href="/" aria-label={`${site.name} — home`}>
      <span class="nav__name">{site.name}</span>
      <span class="label nav__role">{site.shortRole}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav__links" role="list">
        {
          nav.map((item) => (
            <li>
              <a
                class="mono nav__link"
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                {...("external" in item && item.external
                  ? { target: "_blank", rel: "noopener" }
                  : {})}
              >
                {item.label}
                {"external" in item && item.external && (
                  <span class="nav__ext" aria-hidden="true">↗</span>
                )}
              </a>
            </li>
          ))
        }
        <!-- The contact details themselves rather than a button that hides
             them. The email is readable and copyable at a glance, and the
             LinkedIn mark is recognised without needing a word next to it. -->
        <li>
          <a class="mono nav__email" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </li>
        <li>
          <a
            class="nav__li"
            href={site.linkedin}
            rel="me noopener"
            target="_blank"
            aria-label="LinkedIn profile"
            title={site.linkedinLabel}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.13 1.44-2.13 2.93v5.67H9.37V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <hr class="rule" />
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: saturate(1.1) blur(8px);
    -webkit-backdrop-filter: saturate(1.1) blur(8px);
  }
  .nav__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }
  .nav__id {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    text-decoration: none;
    min-width: 0;
  }
  .nav__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .nav__role {
    color: var(--faint);
    /* Hide the role tag once the bar gets tight. */
  }
  @media (max-width: 33rem) {
    .nav__role { display: none; }
  }
  .nav__links {
    display: flex;
    gap: clamp(var(--space-4), 3vw, var(--space-7));
  }
  .nav__link {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--muted);
    position: relative;
    padding-block: var(--space-1);
    transition: color var(--dur-1) var(--ease-out);
  }
  /* Marks a link that leaves the site (the PDF), so the new tab isn't a surprise. */
  .nav__ext {
    font-size: 0.8em;
    margin-left: 0.25em;
    color: var(--faint);
  }

  /* Plain email text, not a button. It reads and copies at a glance. */
  .nav__email {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--muted);
    white-space: nowrap;
    padding-block: var(--space-1);
    transition: color var(--dur-1) var(--ease-out);
  }
  .nav__email:hover { color: var(--accent); }

  /* The LinkedIn mark carries its own meaning, so it needs no label. The
     accessible name lives on aria-label instead. */
  .nav__li {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    padding-block: var(--space-1);
    transition: color var(--dur-1) var(--ease-out);
  }
  .nav__li:hover { color: var(--accent); }
  .nav__li svg { display: block; }
  /* Custom underline that grows from the left on hover — not the default. */
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link:hover::after { transform: scaleX(1); }
  .nav__link:focus-visible { color: var(--ink); }
  .nav__link[aria-current="page"] { color: var(--ink); }
  .nav__link[aria-current="page"]::after { transform: scaleX(1); }
</style>
