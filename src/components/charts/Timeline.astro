---
/**
 * Timeline — a restrained horizontal career/work timeline. Hairline rule,
 * mono date labels, one node per step. The latest node is accent (current).
 * Reflows to a vertical rule on narrow screens. Nodes appear in sequence.
 */
interface Item {
  date: string;
  org: string;
  detail?: string;
}
interface Props {
  label?: string;
  items: Item[];
  context?: string;
}
const { label, items, context } = Astro.props;
const text =
  (label ? label + ": " : "") +
  items.map((i) => `${i.date} ${i.org}`).join(", ") +
  ".";
---

<figure class="tl" data-reveal aria-label={text}>
  {label && <span class="label tl__label">{label}</span>}
  <ol class="tl__track" role="list">
    {
      items.map((item, i) => (
        <li
          class:list={["tl__node", { "tl__node--now": i === items.length - 1 }]}
          style={`--i:${i}`}
        >
          <span class="tl__dot" aria-hidden="true" />
          <span class="mono tl__date">{item.date}</span>
          <span class="tl__org">{item.org}</span>
          {item.detail && <span class="tl__detail">{item.detail}</span>}
        </li>
      ))
    }
  </ol>
  {context && <figcaption class="tl__context">{context}</figcaption>}
</figure>

<style>
  .tl { display: flex; flex-direction: column; gap: var(--space-5); }
  .tl__label { color: var(--muted); }

  .tl__track {
    display: grid;
    gap: var(--space-6);
    position: relative;
  }

  /* ---- Wide: horizontal rule across the top of the nodes ---- */
  @media (min-width: 46rem) {
    .tl__track {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: var(--grid-gap);
      padding-top: var(--space-5);
    }
    .tl__track::before {
      content: "";
      position: absolute;
      top: 5px;
      left: 0;
      right: 0;
      height: var(--hair);
      background: var(--line-strong);
    }
    .tl__node { padding-right: var(--space-4); }
    .tl__dot { position: absolute; top: -1.5rem; }
  }

  .tl__node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .tl__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    transition: box-shadow var(--dur-2) var(--ease-out),
      background var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    transform: scale(0.5);
  }
  :global([data-revealed]) .tl__dot {
    transform: scale(1);
    transition-delay: calc(var(--i) * 90ms);
  }
  .tl__node--now .tl__dot {
    background: var(--accent);
    box-shadow: inset 0 0 0 1.5px var(--accent),
      0 0 0 4px var(--accent-tint);
  }

  .tl__date {
    font-size: var(--step--2);
    color: var(--faint);
    letter-spacing: 0.04em;
  }
  .tl__node--now .tl__date { color: var(--accent); }
  .tl__org {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .tl__detail {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: var(--leading-snug);
    max-width: 24ch;
  }

  /* ---- Narrow: vertical rule down the left ---- */
  @media (max-width: 45.99rem) {
    .tl__track { padding-left: var(--space-5); }
    .tl__track::before {
      content: "";
      position: absolute;
      left: 5px;
      top: 4px;
      bottom: 4px;
      width: var(--hair);
      background: var(--line-strong);
    }
    .tl__dot {
      position: absolute;
      left: calc(-1 * var(--space-5));
      top: 4px;
    }
  }

  .tl__context {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 48ch;
    line-height: var(--leading-snug);
  }
</style>
