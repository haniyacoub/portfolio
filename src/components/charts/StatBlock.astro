---
/**
 * StatBlock — one headline figure with a mono label and a line of context.
 * The workhorse. Big tabular numeral; accent reserved for the figure that
 * matters (emphasis), reinforced by an accent baseline tick so the emphasis
 * survives grayscale.
 */
import { parseFigure } from "../../utils/num";

interface Props {
  label: string;
  value: string;
  unit?: string;
  context?: string;
  emphasis?: boolean;
}
const { label, value, unit, context, emphasis = true } = Astro.props;
const text = `${label}: ${value}${unit ? " " + unit : ""}${context ? ". " + context : ""}`;
const f = parseFigure(value);
---

<figure
  class:list={["stat", { "stat--accent": emphasis }]}
  data-reveal
  aria-label={text}
>
  <span class="label stat__label">{label}</span>
  <div class="stat__value mono">
    {
      f.animatable ? (
        <span
          class="stat__num"
          data-countup={f.value}
          data-prefix={f.prefix}
          data-suffix={f.suffix}
          data-decimals={f.decimals}
          data-group={f.group ? "1" : undefined}
        >
          {value}
        </span>
      ) : (
        <span class="stat__num">{value}</span>
      )
    }
    {unit && <span class="stat__unit mono">{unit}</span>}
  </div>
  {context && <figcaption class="stat__context">{context}</figcaption>}
</figure>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .stat__label { color: var(--muted); }
  .stat__value {
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    line-height: 0.95;
    margin-top: var(--space-1);
  }
  .stat__num {
    font-size: var(--figure-lg);
    font-weight: 540;
    letter-spacing: -0.03em;
    color: var(--ink);
    /* The accent baseline tick lives under just the number. */
    padding-bottom: 0.12em;
    background-image: linear-gradient(var(--line-strong), var(--line-strong));
    background-repeat: no-repeat;
    background-position: left 100%;
    background-size: 0% 2px;
    transition: background-size var(--dur-4) var(--ease-draw) 120ms;
  }
  .stat--accent .stat__num {
    color: var(--accent);
    background-image: linear-gradient(var(--accent), var(--accent));
  }
  /* Tick draws in on reveal. */
  :global([data-revealed]) .stat__num { background-size: 100% 2px; }

  .stat__unit {
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--muted);
  }
  .stat__context {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: var(--leading-snug);
    max-width: 32ch;
    margin-top: var(--space-1);
  }
</style>
