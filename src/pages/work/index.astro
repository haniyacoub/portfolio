---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import WorkItem from "../../components/work/WorkItem.astro";

const works = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const count = String(works.length).padStart(2, "0");
const companies = [...new Set(works.map((w) => w.data.company).filter(Boolean))];
---

<BaseLayout
  title="Work"
  description="Selected fraud-prevention and risk work across AWS and Zalando — investigations, detection, tooling, and measurement, each with the figures that back it."
>
  <section class="section">
    <div class="wrap">
      <header class="wkx__head" data-reveal>
        <span class="label">Selected work</span>
        <h1 class="wkx__title">
          Find the abuse, prove it, and keep the legitimate customers whole.
        </h1>
        <p class="wkx__intro">
          {works.length} cases across AWS Payments &amp; Fraud Prevention, Zalando
          Risk &amp; Abuse, and independent product work: investigations,
          detection systems, shipped products, and the measurement that made
          them defensible. Every figure traces to the case it sits on, and
          sensitive numbers are kept relative.
        </p>
      </header>

      <!-- Company filter tabs -->
      <div class="tabs wkx__tabs" data-tabs aria-label="Filter work by company">
        <div class="tabs__list" role="tablist">
          <button class="tab" role="tab" aria-selected="true" data-company="all">
            All <span class="tab__n mono">{count}</span>
          </button>
          {
            companies.map((co) => (
              <button class="tab" role="tab" aria-selected="false" data-company={co}>
                {co}
                <span class="tab__n mono">
                  {String(works.filter((w) => w.data.company === co).length).padStart(2, "0")}
                </span>
              </button>
            ))
          }
          <span class="tabs__ink" aria-hidden="true"></span>
        </div>
        <span class="mono wkx__count" data-count-target>{count} cases</span>
      </div>

      <ol class="wkx__list" role="list">
        {works.map((entry, i) => <WorkItem entry={entry} index={i} />)}
      </ol>
      <p class="wkx__empty mono" data-empty hidden>No cases in this view.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .wkx__head { max-width: 60ch; }
  .wkx__title {
    font-size: var(--step-4);
    font-weight: 520;
    line-height: var(--leading-tight);
    letter-spacing: -0.035em;
    max-width: 20ch;
    margin-top: var(--space-4);
  }
  .wkx__intro {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: var(--leading-body);
    margin-top: var(--space-5);
    max-width: 58ch;
  }
  .wkx__tabs {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    border-bottom: var(--hair) solid var(--ink);
    padding-bottom: 0;
  }
  .wkx__tabs .tabs__list { gap: var(--space-5); }
  .tab__n { font-size: 0.7em; color: var(--faint); margin-left: 0.4em; vertical-align: super; }
  .tab[aria-selected="true"] .tab__n { color: var(--accent); }
  .wkx__count { font-size: var(--step--1); color: var(--muted); padding-bottom: var(--space-3); }

  .wkx__list { margin-top: var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--grid-gap); align-items: stretch; }
  @media (min-width: 52rem) { .wkx__list { grid-template-columns: 1fr 1fr; } }
  .wkx__empty { color: var(--muted); padding-block: var(--space-8); }

  /* Filtered-out items + entrance */
  .wkx__list :global(.witem.is-out) { display: none; }
  .wkx__list :global(.witem.is-in) { animation: itemIn var(--dur-3) var(--ease-out) both; }
  @keyframes itemIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  function bootWorkTabs() {
    document
      .querySelectorAll<HTMLElement>("[data-tabs]:not([data-init])")
      .forEach((tabs) => {
        tabs.setAttribute("data-init", "1");
        const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>(".tab"));
        const ink = tabs.querySelector<HTMLElement>(".tabs__ink")!;
        const section = tabs.closest("section")!;
        const items = Array.from(section.querySelectorAll<HTMLElement>(".witem"));
        const counter = section.querySelector<HTMLElement>("[data-count-target]");
        const empty = section.querySelector<HTMLElement>("[data-empty]");

        function moveInk(btn: HTMLButtonElement) {
          ink.style.width = btn.offsetWidth + "px";
          ink.style.transform = `translateX(${btn.offsetLeft}px)`;
        }
        function select(btn: HTMLButtonElement) {
          buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
          moveInk(btn);
          const co = btn.dataset.company;
          let shown = 0;
          items.forEach((it) => {
            const match = co === "all" || it.dataset.company === co;
            it.classList.toggle("is-out", !match);
            it.classList.remove("is-in");
            if (match) { shown++; void it.offsetWidth; it.classList.add("is-in"); }
          });
          if (counter) counter.textContent = String(shown).padStart(2, "0") + " cases";
          if (empty) empty.hidden = shown !== 0;
        }
        buttons.forEach((b) => b.addEventListener("click", () => select(b)));
        const initial = buttons.find((b) => b.getAttribute("aria-selected") === "true") || buttons[0];
        requestAnimationFrame(() => moveInk(initial));
        window.addEventListener("resize", () => {
          const cur = buttons.find((b) => b.getAttribute("aria-selected") === "true");
          if (cur) moveInk(cur);
        });
      });
  }
  document.addEventListener("astro:page-load", bootWorkTabs);
  if (document.readyState !== "loading") bootWorkTabs();
</script>
