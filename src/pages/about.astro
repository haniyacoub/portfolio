---
/**
 * /about — kept only as a redirect.
 *
 * The About page was folded into the home page, where the intro is told through
 * the projects rather than sitting in its own room. This route stays because the
 * old URL may already be on a CV, in an email, or in a search index, and a 404
 * is a worse outcome than a hop.
 */
const target = "/#about";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved · Hani Yacoub</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>This moved onto the home page. <a href={target}>Continue to it</a>.</p>
  </body>
</html>
