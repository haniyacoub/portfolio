---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Timeline from "../components/charts/Timeline.astro";
import { career, markets, stack } from "../data/profile";

const principles = [
  {
    title: "False positives first",
    body: "A missed fraudster costs money. A wrongly banned customer costs money and trust, and surfaces weeks later as a support ticket nobody connects to the rule that caused it. Carve-outs come before bulk actions.",
  },
  {
    title: "Evidence before action",
    body: "A flag is a claim, not a verdict. Every case I ship carries the queries and the reasoning that produced it, so the decision can be defended line by line.",
  },
  {
    title: "Verified, not asserted",
    body: "Controls get measured with holdouts. Headline numbers get an adversarial pass before anyone quotes them. Being wrong in draft is cheap.",
  },
];

/* Deliberately mixed: two infrastructure items, one model, one forecast, one
   shipped product. The range is the point — a list of four fraud systems would
   read as a specialist, which undersells four sectors of general data work. */
const builds = [
  { name: "A data platform", note: "two company databases behind one interface, with a background process that made every query about 10× faster" },
  { name: "Dashboards people actually run on", note: "the first single view of a new AWS region, about 40 charts, reconciled to the cent" },
  { name: "Models and forecasts", note: "a fraud-detection model on ~90 signals, and a 40,000-run forecast that overturned a headcount plan" },
  { name: "Investigation agents", note: "AI agents that gather the evidence, then argue with each other before anything ships" },
  { name: "Two products of my own", note: "a published VS Code extension, and a safety check for Shopify imports" },
];

const chips = ["Berlin", "Arabic · German · English", "4 sectors", "6+ years"];
---

<BaseLayout
  title="About"
  description="Hani Yacoub, data and risk analyst in Berlin. Six years across energy, automotive, fashion and cloud — now at AWS on fraud prevention."
>
  <section class="section">
    <div class="wrap ab__lead">
      <span class="label" data-ani>About</span>
      <h1 class="ab__statement" data-ani style="--d: 60ms">
        I'm Hani. I work on the decisions that are expensive to get wrong
        in either direction.
      </h1>
      <p class="ab__intro" data-ani style="--d: 140ms">
        German-Jordanian, based in Berlin. I started in energy markets, moved
        through automotive and fashion, and now work on fraud prevention at
        AWS. Four industries, one job underneath: a big population, a small
        group inside it behaving badly, and a call that costs money whichever
        way you get it wrong. Miss the abuse and it's expensive. Shut down a
        real customer and it's worse.
      </p>
      <ul class="ab__chips" role="list" data-ani style="--d: 220ms">
        {chips.map((c) => <li class="mono ab__chip">{c}</li>)}
      </ul>
    </div>

    <div class="wrap ab__block">
      <span class="label" data-ani>How I work</span>
      <div class="ab__cards">
        {
          principles.map((p, i) => (
            <article class="ab__card" data-ani style={`--d: ${i * 90}ms`}>
              <h2 class="ab__card-title">{p.title}</h2>
              <p class="ab__card-body">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="wrap ab__block">
      <span class="label" data-ani>What I build</span>
      <ul class="ab__builds" role="list">
        {
          builds.map((b, i) => (
            <li class="ab__build" data-ani style={`--d: ${i * 70}ms`}>
              <span class="ab__build-name">{b.name}</span>
              <span class="ab__build-note">{b.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="ab__aside" data-ani>
        Before AWS, at Zalando, I owned fraud metrics for business reviews and
        built the Remaining Fraud Damage measure across six European markets.
        None of it is exotic. It holds up because it gets verified.
      </p>
    </div>

    <div class="wrap ab__arc" data-ani>
      <Timeline label="The arc" items={[...career]} />
    </div>

    <div class="wrap ab__grid">
      <div class="ab__col" data-ani>
        <span class="label">Markets covered</span>
        <p class="ab__markets mono">{markets.join(" · ")}</p>
        <p class="ab__note">
          Zalando Risk &amp; Abuse fraud analytics, top six European markets.
        </p>
      </div>
      <div class="ab__col" data-ani style="--d: 90ms">
        <span class="label">Stack</span>
        <ul class="ab__stack" role="list">
          {stack.map((s) => <li class="mono ab__tool">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ab__lead { display: flex; flex-direction: column; gap: var(--space-5); max-width: 62ch; }
  .ab__statement {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 520;
    line-height: var(--leading-snug);
    letter-spacing: -0.03em;
  }
  .ab__intro {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: var(--leading-body);
  }
  .ab__chips { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .ab__chip {
    font-size: var(--step--1);
    color: var(--muted);
    border: var(--hair) solid var(--line-strong);
    border-radius: 100px;
    padding: 0.25em 0.9em;
  }

  .ab__block { margin-top: var(--space-9); }
  .ab__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-gap);
    margin-top: var(--space-5);
  }
  @media (min-width: 52rem) { .ab__cards { grid-template-columns: repeat(3, 1fr); } }
  .ab__card {
    border: var(--hair) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    padding: var(--space-6);
    transition: transform var(--dur-2) var(--ease-out),
                border-color var(--dur-2) var(--ease-out),
                box-shadow var(--dur-2) var(--ease-out);
  }
  .ab__card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 6px 24px rgba(33, 29, 25, 0.06);
  }
  .ab__card-title { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; }
  .ab__card-body {
    margin-top: var(--space-3);
    font-size: var(--step-0);
    color: var(--ink-soft);
    line-height: var(--leading-body);
  }

  .ab__builds {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 52rem) { .ab__builds { grid-template-columns: 1fr 1fr; column-gap: var(--space-8); } }
  .ab__build {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: var(--hair) solid var(--line);
  }
  .ab__build-name { font-weight: 600; letter-spacing: -0.01em; }
  .ab__build-note { color: var(--muted); font-size: var(--step--1); line-height: var(--leading-snug); }
  .ab__aside {
    margin-top: var(--space-6);
    font-size: var(--step-0);
    color: var(--ink-soft);
    line-height: var(--leading-body);
    max-width: 62ch;
  }

  .ab__arc { margin-top: var(--space-9); }
  .ab__grid {
    margin-top: var(--space-9);
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 52rem) { .ab__grid { grid-template-columns: 1fr 1.2fr; } }
  .ab__markets { margin-top: var(--space-3); font-size: var(--step-1); }
  .ab__note { margin-top: var(--space-2); color: var(--muted); font-size: var(--step--1); }
  .ab__stack {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ab__tool {
    font-size: var(--step--1);
    color: var(--ink-soft);
    border: var(--hair) solid var(--line);
    border-radius: 100px;
    padding: 0.2em 0.75em;
  }

</style>


