---
/**
 * /contact — kept only as a redirect.
 *
 * The contact page held one line and two links, so it became a persistent
 * "Get in touch" button in the nav instead. This route stays because the old URL
 * may already be in circulation, and it lands on the products section, which is
 * where the email button and the two shipped products both sit in view.
 */
const target = "/#about";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved · Hani Yacoub</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>
      Contact is now a button in the site header.
      <a href={target}>Continue to the home page</a>.
    </p>
  </body>
</html>
