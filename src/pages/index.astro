---
import { getCollection } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import WorkItem from "../components/work/WorkItem.astro";
import ThresholdDial from "../components/interactive/ThresholdDial.astro";
import SignalField from "../components/interactive/SignalField.astro";
import { site } from "../data/site";
import { facts } from "../data/profile";
import { parseFigure } from "../utils/num";

const works = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const count = String(works.length).padStart(2, "0");
const companies = [...new Set(works.map((w) => w.data.company).filter(Boolean))];
---

<BaseLayout>
  <!-- ============================ OPENING ============================ -->
  <section class="hero" aria-label="Introduction">
    <div class="wrap">
      <p class="mono hero__kicker" data-reveal>
        {site.role} <span class="hero__dot">/</span> {site.location}
      </p>

      <div class="hero__top">
        <!-- Method in the main clause, domain in the tail: what he does with
             data comes first, fraud arrives second as the deepest domain
             rather than the whole identity. Kept to four short lines so it
             still reads on a phone. Mirrors site.tagline — change both. -->
        <h1 class="hero__statement reveal-lines">
          <span class="reveal-line"><span>I make expensive</span></span>
          <span class="reveal-line"><span>decisions <em>measurable</em>.</span></span>
          <span class="reveal-line"><span>Most of them are</span></span>
          <span class="reveal-line"><span>about fraud.</span></span>
        </h1>

        <div class="hero__viz">
          <SignalField />
        </div>

      </div>

      <div class="hero__lower">
        <!-- The lede does the work the headline deliberately doesn't: it names
             the employer, the domain, and the breadth. Short sentences, common
             words — a smart reader outside fraud should follow every one. -->
        <p class="hero__lede" data-reveal>
          Six years across energy, automotive, fashion and cloud. I build the
          things the answer depends on: the data platforms, the dashboards, the
          models, the forecasts. Right now that's at
          <strong>AWS</strong>, on fraud prevention — where a wrong call costs
          money in both directions, so being right has to be provable.
        </p>

        <dl class="hero__facts" aria-label="At a glance" data-reveal>
          {
            facts.map((f) => {
              const fig = parseFigure(f.value);
              return (
                <div class="hero__fact">
                  <dt class="mono hero__fact-num">
                    <span data-countup={fig.value} data-prefix={fig.prefix} data-suffix={fig.suffix} data-decimals={fig.decimals}>
                      {f.value}
                    </span>
                    <span class="hero__fact-unit">{f.unit}</span>
                  </dt>
                  <dd class="hero__fact-label">{f.label}</dd>
                </div>
              );
            })
          }
        </dl>
      </div>
    </div>

    <a class="hero__scroll mono" href="/#tradeoff" aria-label="Scroll to interactive demo">
      <span>Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ===================== INTERACTIVE: THE TRADEOFF ================= -->
  <ThresholdDial />

  <!-- ====================== FEATURED WORK TEASER ===================== -->
  <section class="feat section" id="work" aria-labelledby="feat-h">
    <div class="wrap">
      <header class="feat__head" data-reveal>
        <div>
          <span class="label">Selected work</span>
          <h2 id="feat-h" class="feat__title">
            Eighteen cases. Each one starts with a number and ends with a
            decision.
          </h2>
        </div>
      </header>

      <div class="tabs feat__tabs" data-tabs aria-label="Filter work by company">
        <div class="tabs__list" role="tablist">
          <button class="tab" role="tab" aria-selected="true" data-company="all">
            All <span class="tab__n mono">{count}</span>
          </button>
          {
            companies.map((co) => (
              <button class="tab" role="tab" aria-selected="false" data-company={co}>
                {co}
                <span class="tab__n mono">
                  {String(works.filter((w) => w.data.company === co).length).padStart(2, "0")}
                </span>
              </button>
            ))
          }
          <span class="tabs__ink" aria-hidden="true"></span>
        </div>
        <span class="mono feat__count" data-count-target>{count} cases</span>
      </div>

      <ol class="feat__list" role="list">
        {works.map((entry, i) => <WorkItem entry={entry} index={i} />)}
      </ol>
      <p class="feat__empty mono" data-empty hidden>No cases in this view.</p>
    </div>
  </section>

  <!-- ========================= ABOUT / CTA STRIP ===================== -->
  <section class="strip section" aria-label="About, in brief">
    <div class="wrap strip__inner" data-reveal>
      <p class="strip__line">
        Based in Berlin. I build the infrastructure, the methodology, and the
        deliverables.
      </p>
      <div class="strip__links">
        <a class="strip__link mono" href="/about">More about me <span aria-hidden="true">→</span></a>
        <a class="strip__link mono" href="/contact">Get in touch <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function bootWorkTabs() {
    document
      .querySelectorAll<HTMLElement>("[data-tabs]:not([data-init])")
      .forEach((tabs) => {
        tabs.setAttribute("data-init", "1");
        const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>(".tab"));
        const ink = tabs.querySelector<HTMLElement>(".tabs__ink")!;
        const section = tabs.closest("section")!;
        const items = Array.from(section.querySelectorAll<HTMLElement>(".witem"));
        const counter = section.querySelector<HTMLElement>("[data-count-target]");
        const empty = section.querySelector<HTMLElement>("[data-empty]");

        /* The tab row wraps on narrow screens. The indicator is positioned
           absolutely inside that wrapping container, so anchoring it to the
           container's bottom edge left it stranded under the wrong row —
           measured 97px below the tab it was supposed to mark on a 390px
           viewport. Tracking offsetTop as well as offsetLeft keeps it attached
           to its own tab on any number of rows. */
        function moveInk(btn: HTMLButtonElement) {
          ink.style.width = btn.offsetWidth + "px";
          ink.style.transform =
            `translate(${btn.offsetLeft}px, ${btn.offsetTop + btn.offsetHeight}px)`;
        }
        function select(btn: HTMLButtonElement) {
          buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
          moveInk(btn);
          const co = btn.dataset.company;
          let shown = 0;
          items.forEach((it) => {
            const match = co === "all" || it.dataset.company === co;
            it.classList.toggle("is-out", !match);
            it.classList.remove("is-in");
            if (match) { shown++; void it.offsetWidth; it.classList.add("is-in"); }
          });
          if (counter) counter.textContent = String(shown).padStart(2, "0") + " cases";
          if (empty) empty.hidden = shown !== 0;
        }
        buttons.forEach((b) => b.addEventListener("click", () => select(b)));
        const initial = buttons.find((b) => b.getAttribute("aria-selected") === "true") || buttons[0];
        requestAnimationFrame(() => moveInk(initial));
        window.addEventListener("resize", () => {
          const cur = buttons.find((b) => b.getAttribute("aria-selected") === "true");
          if (cur) moveInk(cur);
        });
      });
  }
  document.addEventListener("astro:page-load", bootWorkTabs);
  if (document.readyState !== "loading") bootWorkTabs();
</script>


<style>
  /* ============================ OPENING ============================ */
  .hero { position: relative; padding-top: clamp(2.5rem, 1.5rem + 5vw, 5rem); padding-bottom: var(--section-y); }
  .hero__kicker { font-size: var(--step--1); color: var(--muted); letter-spacing: 0.04em; }
  .hero__dot { color: var(--line-strong); margin-inline: 0.4em; }

  .hero__top { margin-top: var(--space-6); display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 56rem) {
    .hero__top { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-7); }
  }
  .hero__statement {
    font-size: clamp(2.3rem, 1.2rem + 3.3vw, 3.9rem);
    font-weight: 520;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .hero__statement em { font-style: italic; color: var(--accent); }

  .hero__viz {
    height: clamp(240px, 38vw, 360px);
    width: 100%;
    border: var(--hair) solid var(--line);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(circle at 60% 40%, rgba(44, 79, 191, 0.06), transparent 60%),
      var(--paper-raised);
    padding: var(--space-4);
  }

  .hero__lower { display: grid; gap: var(--space-7); margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); align-items: end; }
  @media (min-width: 52rem) {
    .hero__lower { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-9); }
  }
  .hero__lede { font-size: var(--step-1); line-height: var(--leading-body); color: var(--ink-soft); max-width: 52ch; }
  .hero__lede strong { color: var(--ink); }
  .hero__lede em { font-style: italic; color: var(--ink); }

  .hero__facts {
    display: flex; flex-wrap: wrap; gap: var(--space-6) var(--space-7);
    border-top: var(--hair) solid var(--line); padding-top: var(--space-5);
  }
  @media (min-width: 52rem) { .hero__facts { justify-content: flex-end; text-align: right; } }
  .hero__fact { display: flex; flex-direction: column; gap: var(--space-1); }
  .hero__fact-num { font-size: var(--figure-md); font-weight: 540; letter-spacing: -0.03em; line-height: 1; color: var(--ink); }
  .hero__fact-unit { font-size: 0.42em; color: var(--muted); margin-left: 0.25em; font-weight: 500; }
  .hero__fact-label { font-size: var(--step--2); color: var(--muted); line-height: 1.3; max-width: 18ch; }
  @media (min-width: 52rem) { .hero__fact { align-items: flex-end; } .hero__fact-label { text-align: right; } }

  .hero__scroll { display: none; }
  @media (min-width: 64rem) {
    .hero__scroll {
      position: absolute; right: var(--gutter); bottom: var(--space-6);
      display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
      font-size: var(--step--2); color: var(--faint); text-decoration: none;
      letter-spacing: 0.1em; text-transform: uppercase;
    }
    .hero__scroll-line { width: 1px; height: 40px; background: var(--line-strong); position: relative; overflow: hidden; }
    .hero__scroll-line::after {
      content: ""; position: absolute; inset: 0; background: var(--accent);
      transform: translateY(-100%); animation: scrollcue 2.4s var(--ease-in-out) infinite;
    }
    @keyframes scrollcue { 0% { transform: translateY(-100%); } 55%,100% { transform: translateY(100%); } }
  }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line::after { animation: none; } }

  /* ====================== FEATURED WORK ===================== */
  .feat__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--space-5); flex-wrap: wrap;
    border-bottom: var(--hair) solid var(--ink); padding-bottom: var(--space-3);
  }
  .feat__title { font-size: var(--step-3); margin-top: var(--space-3); }
  .feat__all { font-size: var(--step--1); color: var(--accent); text-decoration: none; white-space: nowrap; }
  .feat__all:hover { color: var(--accent-deep); }
  /* align-items: start, not stretch. Charts vary a lot in height (a 5-stage
     funnel is ~2× a before/after bar), and stretching forced every card to its
     row-mate's height — leaving up to 584px of empty card below the shorter
     one's chart. Each card is now exactly as tall as its own content. */
  .feat__list { display: grid; grid-template-columns: 1fr; gap: var(--grid-gap); align-items: start; margin-top: var(--space-6); }
  @media (min-width: 52rem) { .feat__list { grid-template-columns: 1fr 1fr; } }
  .feat__tabs {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    border-bottom: var(--hair) solid var(--ink);
  }
  .feat__tabs .tabs__list { gap: var(--space-5); }
  .tab__n { font-size: 0.7em; color: var(--faint); margin-left: 0.4em; vertical-align: super; }
  .tab[aria-selected="true"] .tab__n { color: var(--accent); }
  .feat__count { font-size: var(--step--1); color: var(--muted); padding-bottom: var(--space-3); }
  .feat__empty { color: var(--muted); padding-block: var(--space-8); }
  .feat__list :global(.witem.is-out) { display: none; }

  .feat__cta {
    display: flex; align-items: center; justify-content: center; gap: var(--space-3);
    margin-top: var(--space-8); padding: var(--space-6);
    border: var(--hair) dashed var(--line-strong); border-radius: var(--radius-sm);
    text-decoration: none; color: var(--ink-soft);
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out), background var(--dur-1) var(--ease-out);
  }
  .feat__cta:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-tint); }
  .feat__cta-label { font-size: var(--step-0); letter-spacing: 0.04em; }
  .feat__cta-arrow { transition: transform var(--dur-2) var(--ease-out); }
  .feat__cta:hover .feat__cta-arrow { transform: translateX(5px); }

  /* ====================== ABOUT / CTA STRIP ===================== */
  .strip__inner {
    display: grid; gap: var(--space-6); align-items: end;
    border-top: var(--hair) solid var(--line); padding-top: var(--space-7);
  }
  @media (min-width: 52rem) { .strip__inner { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-8); } }
  .strip__line {
    font-family: var(--font-display); font-size: var(--step-2); font-weight: 460;
    line-height: var(--leading-snug); color: var(--ink-soft); max-width: 42ch;
    letter-spacing: -0.02em;
  }
  .strip__links { display: flex; flex-direction: column; gap: var(--space-3); }
  @media (min-width: 52rem) { .strip__links { align-items: flex-end; } }
  .strip__link { font-size: var(--step-0); color: var(--ink); text-decoration: none; }
  .strip__link:hover { color: var(--accent); }
</style>
