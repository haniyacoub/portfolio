---
import { getCollection } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import WorkItem from "../components/work/WorkItem.astro";
import ThresholdDial from "../components/interactive/ThresholdDial.astro";
import SignalField from "../components/interactive/SignalField.astro";
import Timeline from "../components/charts/Timeline.astro";
import { site, products } from "../data/site";
import { facts, career, education, stack } from "../data/profile";
import { parseFigure } from "../utils/num";

const works = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const count = String(works.length).padStart(2, "0");
const companies = [...new Set(works.map((w) => w.data.company).filter(Boolean))];

/* The intro is told THROUGH the work rather than beside it. Each item pairs one
   thing about how Hani works with the project that proves it, and links to that
   case, so reading about him and reading his work are the same act. Slugs are
   resolved against the live collection so a renamed or drafted case can never
   leave a dead link here. */
const intro = [
  {
    lead: "I start with the false positives.",
    body: "A missed fraudster costs money. A wrongly closed customer costs money and trust, and turns up weeks later as a support ticket nobody connects to the rule that caused it. So the carve-outs get built before the bulk action does.",
    slug: "precision-carveouts",
    proof: "See how the carve-outs work",
  },
  {
    lead: "Then I build whatever the answer depends on.",
    body: "Usually that is infrastructure nobody asked for. Two company databases sat behind two different logins with a slow sign-in on every query, so I put them behind one interface and made queries about ten times faster. Every other project I have shipped runs on it.",
    slug: "fraud-data-platform",
    proof: "See the platform",
  },
  {
    lead: "I do not trust a number until something has tried to break it.",
    body: "Headline figures get attacked before they reach anyone. On its founding case it caught a silently truncated query and moved the headline by 69 percent. Catching that in draft beats being wrong in a room full of stakeholders.",
    slug: "multi-agent-investigation",
    proof: "See the verification loop",
  },
  {
    lead: "And the same instinct works outside fraud.",
    body: "Before AWS I scored which customers were worth calling at an automotive marketplace, cut a Zalando pipeline from 34 minutes to a few, and put a euro figure on refund abuse across six markets. Same job underneath, different domain on top.",
    slug: "auto1-customer-scoring",
    proof: "See the scoring work",
  },
];
/* Every habit is always shown. Only the "see the case" link is conditional,
   because unpublishing a case must not silently delete a paragraph about how he
   works. The earlier version filtered the whole item and dropped two of the four
   the moment two cases were unticked, leaving the copy promising four habits and
   rendering two. */
const liveSlugs = new Set(works.map((w) => w.id));
const introItems = intro.map((i) => ({
  ...i,
  href: liveSlugs.has(i.slug) ? `/work/${i.slug}` : null,
}));
---

<BaseLayout>
  <!-- ============================ OPENING ============================ -->
  <section class="hero" aria-label="Introduction">
    <div class="wrap">
      <p class="mono hero__kicker" data-reveal>
        {site.role} <span class="hero__dot">/</span> {site.location}
      </p>

      <div class="hero__top">
        <!-- Not a slogan. A slogan asks to be believed. This states what was
             built and lets the work carry it. Each line is a real thing that
             shipped, so the opening screen is evidence rather than a claim. -->
        <h1 class="hero__statement reveal-lines">
          <span class="reveal-line"><span>I built the platform,</span></span>
          <span class="reveal-line"><span>the dashboards, the models</span></span>
          <span class="reveal-line"><span>and the forecasts that</span></span>
          <span class="reveal-line"><span><em>fraud decisions</em> run on.</span></span>
        </h1>

        <div class="hero__viz">
          <SignalField />
        </div>

      </div>

      <div class="hero__lower">
        <!-- Names the employer, the domain and the breadth. Short sentences,
             common words, so a reader outside fraud follows every one. -->
        <p class="hero__lede" data-reveal>
          Six years across energy, automotive, fashion and cloud. Now at
          <strong>AWS</strong>, on fraud prevention, where a wrong call costs
          money in both directions. Miss the abuse and it is expensive. Shut
          down a real customer and it is worse. So I measure both sides before
          anyone acts.
        </p>

        <dl class="hero__facts" aria-label="At a glance" data-reveal>
          {
            facts.map((f) => {
              const fig = parseFigure(f.value);
              return (
                <div class="hero__fact">
                  <dt class="mono hero__fact-num">
                    <span data-countup={fig.value} data-prefix={fig.prefix} data-suffix={fig.suffix} data-decimals={fig.decimals}>
                      {f.value}
                    </span>
                    <span class="hero__fact-unit">{f.unit}</span>
                  </dt>
                  <dd class="hero__fact-label">{f.label}</dd>
                </div>
              );
            })
          }
        </dl>
      </div>
    </div>

    <a class="hero__scroll mono" href="/#tradeoff" aria-label="Scroll to interactive demo">
      <span>Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ===================== INTERACTIVE: THE TRADEOFF ================= -->
  <ThresholdDial />

  <!-- ===================== ABOUT, TOLD THROUGH THE WORK ============== -->
  <section class="me section" id="about" aria-labelledby="me-h">
    <div class="wrap">
      <header class="me__head" data-reveal>
        <span class="label">Who is doing this</span>
        <h2 id="me-h" class="me__title">
          I am Hani. Based in Berlin, six years in data.
        </h2>
        <p class="me__sub">
          The short version is four habits and the projects that came out of
          them.
        </p>
      </header>

      <ol class="me__list" role="list">
        {
          introItems.map((item, i) => (
            <li class="me__item" data-reveal data-reveal-delay={i * 70}>
              <span class="mono me__n">{String(i + 1).padStart(2, "0")}</span>
              <div class="me__body">
                <h3 class="me__lead">{item.lead}</h3>
                <p class="me__text">{item.body}</p>
                {
                  item.href && (
                    <a class="mono me__proof" href={item.href}>
                      {item.proof} <span aria-hidden="true">→</span>
                    </a>
                  )
                }
              </div>
            </li>
          ))
        }
      </ol>

      <div class="me__grid">
        <div class="me__col" data-reveal>
          <Timeline label="Where I have worked" items={[...career]} />
        </div>
        <div class="me__col" data-reveal data-reveal-delay="90">
          <span class="label">Studied</span>
          <ul class="me__edu" role="list">
            {
              education.map((e) => (
                <li class="me__eduitem">
                  <span class="me__eduwhat">{e.what}</span>
                  <span class="me__eduwhere">{e.where}</span>
                </li>
              ))
            }
          </ul>
          <span class="label me__stacklabel">Tools</span>
          <ul class="me__stack" role="list">
            {stack.map((s) => <li class="mono me__tool">{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SHIPPED PRODUCTS (CLICKABLE) ============== -->
  <section class="prod section" aria-labelledby="prod-h">
    <div class="wrap">
      <header class="prod__head" data-reveal>
        <span class="label">Built on my own time</span>
        <h2 id="prod-h" class="prod__title">
          Two products you can go and use right now.
        </h2>
      </header>
      <ul class="prod__list" role="list">
        {
          products.map((p, i) => (
            <li class="prod__item" data-reveal data-reveal-delay={i * 80}>
              <a class="prod__link" href={p.url} target="_blank" rel="noopener">
                <span class="prod__name">{p.name}</span>
                <span class="mono prod__url">{p.label} <span aria-hidden="true">↗</span></span>
              </a>
              <p class="prod__note">{p.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <!-- ====================== FEATURED WORK TEASER ===================== -->
  <section class="feat section" id="work" aria-labelledby="feat-h">
    <div class="wrap">
      <header class="feat__head" data-reveal>
        <div>
          <span class="label">Selected work</span>
          <h2 id="feat-h" class="feat__title">
            Eighteen cases. Each one starts with a number and ends with a
            decision.
          </h2>
        </div>
      </header>

      <div class="tabs feat__tabs" data-tabs aria-label="Filter work by company">
        <div class="tabs__list" role="tablist">
          <button class="tab" role="tab" aria-selected="true" data-company="all">
            All <span class="tab__n mono">{count}</span>
          </button>
          {
            companies.map((co) => (
              <button class="tab" role="tab" aria-selected="false" data-company={co}>
                {co}
                <span class="tab__n mono">
                  {String(works.filter((w) => w.data.company === co).length).padStart(2, "0")}
                </span>
              </button>
            ))
          }
          <span class="tabs__ink" aria-hidden="true"></span>
        </div>
        <span class="mono feat__count" data-count-target>{count} cases</span>
      </div>

      <ol class="feat__list" role="list">
        {works.map((entry, i) => <WorkItem entry={entry} index={i} />)}
      </ol>
      <p class="feat__empty mono" data-empty hidden>No cases in this view.</p>
    </div>
  </section>

</BaseLayout>

<script>
  function bootWorkTabs() {
    document
      .querySelectorAll<HTMLElement>("[data-tabs]:not([data-init])")
      .forEach((tabs) => {
        tabs.setAttribute("data-init", "1");
        const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>(".tab"));
        const ink = tabs.querySelector<HTMLElement>(".tabs__ink")!;
        const section = tabs.closest("section")!;
        const items = Array.from(section.querySelectorAll<HTMLElement>(".witem"));
        const counter = section.querySelector<HTMLElement>("[data-count-target]");
        const empty = section.querySelector<HTMLElement>("[data-empty]");

        /* The tab row wraps on narrow screens. The indicator is positioned
           absolutely inside that wrapping container, so anchoring it to the
           container's bottom edge left it stranded under the wrong row. It
           measured 97px below the tab it was supposed to mark on a 390px
           viewport. Tracking offsetTop as well as offsetLeft keeps it attached
           to its own tab on any number of rows. */
        function moveInk(btn: HTMLButtonElement) {
          ink.style.width = btn.offsetWidth + "px";
          ink.style.transform =
            `translate(${btn.offsetLeft}px, ${btn.offsetTop + btn.offsetHeight}px)`;
        }
        function select(btn: HTMLButtonElement) {
          buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
          moveInk(btn);
          const co = btn.dataset.company;
          let shown = 0;
          items.forEach((it) => {
            const match = co === "all" || it.dataset.company === co;
            it.classList.toggle("is-out", !match);
            it.classList.remove("is-in");
            if (match) { shown++; void it.offsetWidth; it.classList.add("is-in"); }
          });
          if (counter) counter.textContent = String(shown).padStart(2, "0") + " cases";
          if (empty) empty.hidden = shown !== 0;
        }
        buttons.forEach((b) => b.addEventListener("click", () => select(b)));
        const initial = buttons.find((b) => b.getAttribute("aria-selected") === "true") || buttons[0];
        requestAnimationFrame(() => moveInk(initial));
        window.addEventListener("resize", () => {
          const cur = buttons.find((b) => b.getAttribute("aria-selected") === "true");
          if (cur) moveInk(cur);
        });
      });
  }
  document.addEventListener("astro:page-load", bootWorkTabs);
  if (document.readyState !== "loading") bootWorkTabs();
</script>


<style>
  /* ============================ OPENING ============================ */
  .hero { position: relative; padding-top: clamp(2.5rem, 1.5rem + 5vw, 5rem); padding-bottom: var(--section-y); }
  .hero__kicker { font-size: var(--step--1); color: var(--muted); letter-spacing: 0.04em; }
  .hero__dot { color: var(--line-strong); margin-inline: 0.4em; }

  .hero__top { margin-top: var(--space-6); display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 56rem) {
    .hero__top { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-7); }
  }
  .hero__statement {
    font-size: clamp(2.3rem, 1.2rem + 3.3vw, 3.9rem);
    font-weight: 520;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .hero__statement em { font-style: italic; color: var(--accent); }

  .hero__viz {
    height: clamp(240px, 38vw, 360px);
    width: 100%;
    border: var(--hair) solid var(--line);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(circle at 60% 40%, rgba(44, 79, 191, 0.06), transparent 60%),
      var(--paper-raised);
    padding: var(--space-4);
  }

  .hero__lower { display: grid; gap: var(--space-7); margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); align-items: end; }
  @media (min-width: 52rem) {
    .hero__lower { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-9); }
  }
  .hero__lede { font-size: var(--step-1); line-height: var(--leading-body); color: var(--ink-soft); max-width: 52ch; }
  .hero__lede strong { color: var(--ink); }
  .hero__lede em { font-style: italic; color: var(--ink); }

  .hero__facts {
    display: flex; flex-wrap: wrap; gap: var(--space-6) var(--space-7);
    border-top: var(--hair) solid var(--line); padding-top: var(--space-5);
  }
  @media (min-width: 52rem) { .hero__facts { justify-content: flex-end; text-align: right; } }
  .hero__fact { display: flex; flex-direction: column; gap: var(--space-1); }
  .hero__fact-num { font-size: var(--figure-md); font-weight: 540; letter-spacing: -0.03em; line-height: 1; color: var(--ink); }
  .hero__fact-unit { font-size: 0.42em; color: var(--muted); margin-left: 0.25em; font-weight: 500; }
  .hero__fact-label { font-size: var(--step--2); color: var(--muted); line-height: 1.3; max-width: 18ch; }
  @media (min-width: 52rem) { .hero__fact { align-items: flex-end; } .hero__fact-label { text-align: right; } }

  .hero__scroll { display: none; }
  @media (min-width: 64rem) {
    .hero__scroll {
      position: absolute; right: var(--gutter); bottom: var(--space-6);
      display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
      font-size: var(--step--2); color: var(--faint); text-decoration: none;
      letter-spacing: 0.1em; text-transform: uppercase;
    }
    .hero__scroll-line { width: 1px; height: 40px; background: var(--line-strong); position: relative; overflow: hidden; }
    .hero__scroll-line::after {
      content: ""; position: absolute; inset: 0; background: var(--accent);
      transform: translateY(-100%); animation: scrollcue 2.4s var(--ease-in-out) infinite;
    }
    @keyframes scrollcue { 0% { transform: translateY(-100%); } 55%,100% { transform: translateY(100%); } }
  }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line::after { animation: none; } }

  /* ====================== FEATURED WORK ===================== */
  .feat__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--space-5); flex-wrap: wrap;
    border-bottom: var(--hair) solid var(--ink); padding-bottom: var(--space-3);
  }
  .feat__title { font-size: var(--step-3); margin-top: var(--space-3); }
  .feat__all { font-size: var(--step--1); color: var(--accent); text-decoration: none; white-space: nowrap; }
  .feat__all:hover { color: var(--accent-deep); }
  /* align-items: start, not stretch. Charts vary a lot in height (a 5-stage
     funnel is ~2× a before/after bar), and stretching forced every card to its
     row-mate's height. That left up to 584px of empty card below the shorter
     one's chart. Each card is now exactly as tall as its own content. */
  .feat__list { display: grid; grid-template-columns: 1fr; gap: var(--grid-gap); align-items: start; margin-top: var(--space-6); }
  @media (min-width: 52rem) { .feat__list { grid-template-columns: 1fr 1fr; } }
  .feat__tabs {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    border-bottom: var(--hair) solid var(--ink);
  }
  .feat__tabs .tabs__list { gap: var(--space-5); }
  .tab__n { font-size: 0.7em; color: var(--faint); margin-left: 0.4em; vertical-align: super; }
  .tab[aria-selected="true"] .tab__n { color: var(--accent); }
  .feat__count { font-size: var(--step--1); color: var(--muted); padding-bottom: var(--space-3); }
  .feat__empty { color: var(--muted); padding-block: var(--space-8); }
  .feat__list :global(.witem.is-out) { display: none; }

  .feat__cta {
    display: flex; align-items: center; justify-content: center; gap: var(--space-3);
    margin-top: var(--space-8); padding: var(--space-6);
    border: var(--hair) dashed var(--line-strong); border-radius: var(--radius-sm);
    text-decoration: none; color: var(--ink-soft);
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out), background var(--dur-1) var(--ease-out);
  }
  .feat__cta:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-tint); }
  .feat__cta-label { font-size: var(--step-0); letter-spacing: 0.04em; }
  .feat__cta-arrow { transition: transform var(--dur-2) var(--ease-out); }
  .feat__cta:hover .feat__cta-arrow { transform: translateX(5px); }

  /* ============ ABOUT, TOLD THROUGH THE WORK ============ */
  .me__head { border-bottom: var(--hair) solid var(--ink); padding-bottom: var(--space-4); }
  .me__title { font-size: var(--step-3); margin-top: var(--space-3); max-width: 34ch; }
  .me__sub {
    font-size: var(--step-1); color: var(--muted); margin-top: var(--space-3);
    max-width: 48ch; line-height: var(--leading-body);
  }

  .me__list { margin-top: var(--space-7); display: grid; gap: var(--space-7); }
  @media (min-width: 60rem) {
    .me__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8) var(--space-9); }
  }
  .me__item { display: grid; grid-template-columns: 2.2rem 1fr; gap: var(--space-3); }
  .me__n { font-size: var(--step--2); color: var(--faint); padding-top: 0.35rem; }
  .me__body { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .me__lead {
    font-family: var(--font-display); font-size: var(--step-2); font-weight: 500;
    line-height: var(--leading-snug); letter-spacing: -0.02em; color: var(--ink);
    max-width: 26ch;
  }
  .me__text {
    font-size: var(--step-0); color: var(--ink-soft);
    line-height: var(--leading-body); max-width: 48ch;
  }
  .me__proof { font-size: var(--step--1); color: var(--accent); text-decoration: none; }
  .me__proof:hover { color: var(--accent-deep); }

  .me__grid {
    margin-top: var(--space-9); display: grid; gap: var(--space-7);
    border-top: var(--hair) solid var(--line); padding-top: var(--space-7);
  }
  @media (min-width: 52rem) { .me__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-8); } }
  .me__col { min-width: 0; }
  .me__edu { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-3); }
  .me__eduitem { display: flex; flex-direction: column; gap: 0.15em; }
  .me__eduwhat { font-size: var(--step-0); color: var(--ink); font-weight: 500; }
  .me__eduwhere {
    font-size: var(--step--1); color: var(--muted);
    line-height: var(--leading-snug); max-width: 34ch;
  }
  .me__stacklabel { display: block; margin-top: var(--space-6); }
  .me__stack { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin-top: var(--space-3); }
  .me__tool {
    font-size: var(--step--2); color: var(--muted);
    border: var(--hair) solid var(--line-strong); border-radius: 100px;
    padding: 0.25em 0.85em;
  }

  /* ====================== SHIPPED PRODUCTS ===================== */
  .prod__head { border-bottom: var(--hair) solid var(--ink); padding-bottom: var(--space-4); }
  .prod__title { font-size: var(--step-3); margin-top: var(--space-3); max-width: 30ch; }
  .prod__list { margin-top: var(--space-6); display: grid; gap: var(--space-6); }
  @media (min-width: 44rem) { .prod__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-7); } }
  .prod__item {
    display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-6); border: var(--hair) solid var(--line);
    border-radius: var(--radius-sm); background: var(--paper-raised);
    transition: border-color var(--dur-1) var(--ease-out);
  }
  .prod__item:hover { border-color: var(--accent); }
  .prod__link {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-4); flex-wrap: wrap;
    text-decoration: none; color: var(--ink);
    transition: color var(--dur-1) var(--ease-out);
  }
  .prod__link:hover { color: var(--accent); }
  .prod__name {
    font-family: var(--font-display); font-size: var(--step-2);
    font-weight: 520; letter-spacing: -0.02em;
  }
  .prod__url { font-size: var(--step--2); color: var(--accent); }
  .prod__note {
    font-size: var(--step-0); color: var(--ink-soft);
    line-height: var(--leading-body); max-width: 40ch;
  }
</style>
